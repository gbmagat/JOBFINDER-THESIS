{
  "name": "jobfinder-thesis",
  "private": true,
  "version": "4.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "backup": "npm --prefix backend run backup",
    "verify:backup": "npm --prefix backend run verify:backup --",
    "import:peso-lgu": "npm --prefix backend run import:peso-lgu --",
    "check:docker": "node scripts/check-docker-safety.mjs",
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "release:check": "npm run check:privacy && npm run check:docker && npm run check && npm test && npm run test:e2e && npm run smoke:production",
    "test": "npm --prefix frontend run test && npm --prefix backend test",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "check": "npm --prefix frontend run check && npm --prefix backend run check",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
