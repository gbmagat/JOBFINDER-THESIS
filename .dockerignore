# Deny by default: only application build inputs may enter the build context.
**
!Dockerfile
!package.json
!package-lock.json
!index.html
!tsconfig.json
!vite.config.ts
!.figma/
.figma/**
!.figma/make/
.figma/make/**
!.figma/make/site.json
!src/
!src/**
!public/
!public/**
!server/
server/**
!server/*.js
!server/schema.sql
!server/cli/
server/cli/**
!server/cli/*.js
!docker/
docker/**
!docker/api.mjs
!docker/runtime-config.mjs
!docker/entrypoint.sh
!docker/nginx.conf
# Defense in depth even if private files are accidentally placed under src/public.
**/.env*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/node_modules
**/uploads
**/backups
**/.git
